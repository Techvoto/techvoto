# Dev only: where the Vite dev server proxies /api to.
VITE_PROXY_TARGET=http://localhost:8000

# Production on Vercel: set this to the verified HTTPS Render API origin. Do not guess it.
# Empty is for local same-origin dev proxy only; vercel.json deliberately does not rewrite /api to index.html.
# Configure exact credentialed CORS + CSRF trusted origins and compatible cookies on Django.
# Cross-site cookies require SameSite=None + Secure, but Safari may block third-party cookies.
# Prefer app/api custom subdomains on the same registrable domain for the supported Safari target.
VITE_API_URL=
